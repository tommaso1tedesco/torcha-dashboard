# Postgres (Railway te la fornisce come variabile DATABASE_URL sul servizio Postgres;
# su Railway collega questa env var al servizio web/worker con un reference,
# oppure incollala qui in locale per lo sviluppo)
DATABASE_URL=postgresql://user:password@localhost:5432/torcha

# Token Apify (Parte 2: Google Trends/SERP, TikTok, YouTube, X, Reddit).
# Se vuoto, l'ingest Parte 2 viene saltato in modo pulito (log chiaro, nessun errore).
APIFY_TOKEN=

# Categorie attive per l'ingest (comma-separated, chiavi come in sources.yaml).
ACTIVE_CATEGORIES=attualita,ultima_ora,economia,politica,tecnologia,curiosita

# Finestra (ore) su cui la dashboard mostra/clusterizza gli articoli
DASHBOARD_WINDOW_HOURS=24
